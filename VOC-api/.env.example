# ─────────────────────────────────────────────────────────────
# VOC Church API — Environment variables
# Copy to .env and fill in values (never commit .env)
# ─────────────────────────────────────────────────────────────

# Port the HTTP server listens on (default: 3333)
PORT=3333

# PostgreSQL connection string (required in production)
DATABASE_URL="postgresql://voc:voc_local@localhost:15432/voc?schema=public"

# JWT signing secret — at least 32 characters (required in production)
JWT_SECRET=

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5174

# Admin bootstrap credentials (used by `npm run seed:admin`)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# WhatsApp Evolution API (optional). When EVOLUTION_URL is set,
# EVOLUTION_API_KEY is required.
EVOLUTION_URL=
EVOLUTION_API_KEY=

# Weekly inactive-members job (Monday 8AM). true|false
CRON_ENABLED=false

# Environment: development | test | production
NODE_ENV=development